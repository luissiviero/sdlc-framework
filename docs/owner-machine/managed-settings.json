{
  "permissions": {
    "deny": [
      "Read(.env*)",
      "Read(**/.env*)",
      "Read(./secrets/**)",
      "Read(**/secrets/**)",
      "Edit(.claude/**)",
      "Edit(CLAUDE.md)",
      "Edit(REVIEW.md)",
      "Edit(sdlc.yaml)",
      "WebFetch",
      "Bash(curl *)",
      "Bash(wget *)"
    ],
    "allow": [
      "Bash(git *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(py *)",
      "Bash(pytest*)",
      "Bash(ruff*)",
      "Bash(npm test*)",
      "Bash(npm run *)",
      "Bash(make *)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "allowManagedPermissionRulesOnly": true,
  "allowManagedHooksOnly": true,
  "extraKnownMarketplaces": {
    "sdlc-framework": {
      "source": {
        "source": "github",
        "repo": "luissiviero/sdlc-framework"
      }
    }
  },
  "enabledPlugins": {
    "sdlc@sdlc-framework": true
  }
}
