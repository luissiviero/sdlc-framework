{
  "description": "SDLC framework build-time guardrails (build guide step 15). Exec form: `python` is spawned directly with the script path, so no shell is involved on Windows, macOS or Linux.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/protected_paths.py",
              "--plugin-root",
              "${CLAUDE_PLUGIN_ROOT}"
            ],
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/secrets_check.py"],
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "python",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/plan_sync.py"],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "PowerShell(git commit *)",
            "command": "python",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/plan_sync.py"],
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/format_on_edit.py"],
            "timeout": 60
          }
        ]
      }
    ]
  }
}
