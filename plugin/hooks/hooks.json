{
  "description": "SDLC framework guardrails (build guide step 15) and the production gate (step 29: with sdlc.yaml deploy.production true, a guarded production command on Bash or PowerShell needs the release approval; it only allows or blocks, never asks). Exec form: `python` is spawned directly with the script path, so no shell is involved on Windows, macOS or Linux. The plugin root is the framework repository root; scripts live under plugin/hooks/.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/plugin/hooks/protected_paths.py",
              "--plugin-root",
              "${CLAUDE_PLUGIN_ROOT}"
            ],
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PLUGIN_ROOT}/plugin/hooks/test_file_lock.py"],
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PLUGIN_ROOT}/plugin/hooks/secrets_check.py"],
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "python",
            "args": ["${CLAUDE_PLUGIN_ROOT}/plugin/hooks/plan_sync.py"],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "PowerShell(git *)",
            "command": "python",
            "args": ["${CLAUDE_PLUGIN_ROOT}/plugin/hooks/plan_sync.py"],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PLUGIN_ROOT}/plugin/hooks/production_gate.py"],
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PLUGIN_ROOT}/plugin/hooks/format_on_edit.py"],
            "timeout": 60
          }
        ]
      }
    ]
  }
}
