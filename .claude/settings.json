{
  "permissions": {
    "deny": [
      "Read(.env*)",
      "Read(**/.env*)",
      "Read(./secrets/**)",
      "Read(**/secrets/**)",
      "Edit(.claude/**)",
      "Edit(CLAUDE.md)",
      "Edit(REVIEW.md)",
      "Edit(sdlc.yaml)",
      "WebFetch",
      "Bash(curl *)",
      "Bash(wget *)"
    ],
    "allow": [
      "Bash(git *)",
      "Bash(python -m compileall *)",
      "Bash(python -m pytest *)",
      "Bash(python -m ruff *)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": false,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "pypi.org",
        "files.pythonhosted.org"
      ]
    }
  },
  "extraKnownMarketplaces": {
    "sdlc-framework": {
      "source": {
        "source": "github",
        "repo": "luissiviero/sdlc-framework"
      }
    }
  },
  "enabledPlugins": {
    "sdlc@sdlc-framework": true
  }
}
