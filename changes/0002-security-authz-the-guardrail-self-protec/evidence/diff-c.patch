++++    assert shell_guard.shell_write_targets("rm a.txt || echo x > CLAUDE.md") == [
++++        "a.txt",
++++        "CLAUDE.md",
++++    ]
++++    assert shell_guard.shell_write_targets("rm a.txt | rm CLAUDE.md") == ["a.txt", "CLAUDE.md"]
