++++
++++def _git_dash_c(words: list[str]) -> tuple[str, list[str]] | None:
++++    if len(words) >= 3 and words[0] == "git" and words[1] == "-C":
++++        return words[2], ["git", *words[3:]]
++++    return None
++++
