+++def test_shell_write_targets_splits_a_chain_only_on_the_documented_operators():
+++    assert shell_guard.shell_write_targets("rm a.txt; echo x > CLAUDE.md") == [
+++        "a.txt",
+++        "CLAUDE.md",
+++    ]
