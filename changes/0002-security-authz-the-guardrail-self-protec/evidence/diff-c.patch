++++def _interpreter_targets(text: str) -> list[str]:
++++    out: list[str] = []
++++    for m in _PY_OPEN_RE.finditer(text):
++++        mode = m.group(2)
++++        if mode is not None and _WRITE_MODE_RE.search(mode):
