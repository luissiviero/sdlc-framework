+def test_shell_write_targets_sees_through_wrappers_and_inner_shells():
+    for command in (
+        "sudo rm CLAUDE.md",
+        "nohup rm CLAUDE.md",
+        "time rm CLAUDE.md",
+        "env rm CLAUDE.md",
