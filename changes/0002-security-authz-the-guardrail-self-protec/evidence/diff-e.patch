+++# --- PowerShell cmdlets and their aliases -----------------------------------------------------
+++_PS_CMDLETS = {
+++    "set-content",
+++    "add-content",
+++    "out-file",
+++    "new-item",
+++    "copy-item",
+++    "move-item",
+++    "rename-item",
+++    "remove-item",
+++    "clear-content",
+++    "tee-object",
