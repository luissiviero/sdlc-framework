+++    targets.extend(_powershell_targets(words))
+++    targets.extend(_ps_static_targets(raw))
+++    code = _interpreter_code_argument(words)
+++    if code is not None:
+++        targets.extend(_interpreter_targets(code))
+++    return list(dict.fromkeys(targets))
