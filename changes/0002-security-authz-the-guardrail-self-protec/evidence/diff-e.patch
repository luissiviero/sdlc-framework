+++_PS_ALIASES = {"sc", "ac", "ni", "cpi", "mi", "rni", "ri", "del", "erase", "rm"}
+++_PS_PATH_FLAGS = {"-path", "-literalpath", "-filepath", "-destination"}
+++_PS_SWITCH_FLAGS = {"-recurse", "-force", "-whatif", "-confirm", "-passthru", "-nonewline"}
+++_PS_PARAM_RE = re.compile(r"^-([A-Za-z]+)(?::(.*))?$")
