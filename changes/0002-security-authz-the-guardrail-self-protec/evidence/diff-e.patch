+++def _powershell_targets(words: list[str]) -> list[str]:
+++    if not words or words[0].lower() not in (_PS_CMDLETS | _PS_ALIASES):
+++        return []
+++    rest = words[1:]
+++    targets: list[str] = []
+++    found_path_flag = False
+++    positionals: list[str] = []
+++    i = 0
+++    while i < len(rest):
