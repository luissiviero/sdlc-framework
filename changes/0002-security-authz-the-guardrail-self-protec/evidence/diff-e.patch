++++++        text=True,
++++++        env={**os.environ, "CLAUDE_PROJECT_DIR": str(project), "SDLC_HOOK_LOG": str(log_path)},
++++++    )
++++++    assert proc.returncode == 0 and proc.stdout == "" and proc.stderr == ""
