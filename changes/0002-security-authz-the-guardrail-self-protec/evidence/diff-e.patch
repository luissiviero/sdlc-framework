+++def _is_ancestor_of_protected(resolved: str, protected_roots: list[str]) -> bool:
+++    cand = protected_paths.norm(resolved).rstrip("/")
+++    return any(prot == cand or prot.startswith(cand + "/") for prot in protected_roots)
