+
+    eval_dir = ctx.root / "evals" / "cases" / f"{ctx.status.id}-{ctx.status.slug}"
+    eval_rel = eval_dir.relative_to(ctx.root).as_posix()
+    for name in (art.EVAL_PROMPT, art.EVAL_CHECKS):
