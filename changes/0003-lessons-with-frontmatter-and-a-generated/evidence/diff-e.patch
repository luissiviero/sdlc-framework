++++    if unsorted:
++++        by_name = sorted(unsorted, key=lambda e: e.file_name)
++++        blocks.append([UNSORTED_HEADING] + [_render_unsorted_line(e) for e in by_name])
++++    return "\n\n".join("\n".join(b) for b in blocks) + "\n"
