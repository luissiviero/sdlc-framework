++++FRONTMATTER_RE = re.compile(r"^---\n(.*?)\n---\n(.*)$", re.S)
++++HEADING_RE = re.compile(r"^#{1,6}\s+(\S.*)$")
++++STALE_SUFFIX_RE = re.compile(r" \(stale\)$", re.MULTILINE)
++++DATE_RE = re.compile(r"^(\d{4})-(\d{2})")
