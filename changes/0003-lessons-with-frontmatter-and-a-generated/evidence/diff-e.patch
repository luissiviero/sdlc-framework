+++++    return Entry(
+++++        path.name,
+++++        ok=True,
+++++        title=fm["title"],
+++++        description=fm["description"],
+++++        tags=[str(t) for t in fm["tags"]],
+++++        tier=detected.get("tier"),
+++++        detected_at=str(detected.get("at")),
+++++        status=str(fm.get("status") or "stable"),
+++++        stale_after=fm.get("stale_after"),
+++++    )
