++++++++def _lesson_field_problems(lesson_name: str, fm: dict[str, Any]) -> list[str]:
++++++++    problems = []
++++++++    for name, kind in art.LESSON_REQUIRED_FIELDS.items():
++++++++        value = fm.get(name)
++++++++        present = (
++++++++            (kind == "scalar" and isinstance(value, str) and value.strip())
