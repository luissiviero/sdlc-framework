++++        f"{_month_label(e.detected_at)}. Tags: {', '.join(e.tags)}."
++++    )
++++    if is_stale(e.stale_after, today):
++++        line += " (stale)"
++++    return line
++++
++++
++++def _render_unsorted_line(e: Entry) -> str:
++++    return f"* [{e.heading or e.file_name}]({e.file_name})"
