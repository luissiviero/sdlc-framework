++++@dataclass
++++class Entry:
++++    """One lesson file, either rendered or sent to ``## Unsorted``."""
++++
++++    file_name: str
++++    ok: bool
++++    error: str = ""
++++    heading: str = ""  # the file's first markdown heading, shown when not ok
++++    title: str = ""
++++    description: str = ""
++++    tags: list[str] = field(default_factory=list)
++++    tier: int | None = None
++++    detected_at: str = ""
++++    status: str = "stable"
++++    stale_after: str | None = None
