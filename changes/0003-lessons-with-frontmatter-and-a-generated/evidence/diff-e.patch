+++        if missing_eval_file != "prompt.md":
+++            write(eval_dir / "prompt.md", "Incident 0001: x.\n")
+++        if missing_eval_file != "checks.yaml":
+++            write(eval_dir / "checks.yaml", "checks:\n  - command: pytest\n    exit: 0\n")
