++++++++DEFAULT_FRONTMATTER = {
++++++++    "type": "Lesson",
++++++++    "title": "CI flaked on checkout",
++++++++    "description": "ci_test_failure_rate tripped we1",
++++++++    "tags": ["flaky-test", "ci_test_failure_rate"],
