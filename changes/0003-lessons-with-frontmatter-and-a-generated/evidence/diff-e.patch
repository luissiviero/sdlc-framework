+++++def normalise_class(value: str) -> str:
+++++    """``flaky-test``, ``flaky_test`` and ``Flaky Test`` all become ``flaky-test``, so a
+++++    spelling drift never opens a second heading for the same class."""
+++++    return re.sub(r"[ _]+", "-", value.strip().lower())
