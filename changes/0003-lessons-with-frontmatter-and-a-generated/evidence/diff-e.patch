++++def _month_label(at: str) -> str:
++++    m = DATE_RE.match(at or "")
++++    if not m:
++++        return ""
++++    year, month = int(m.group(1)), int(m.group(2))
++++    return f"{calendar.month_abbr[month]} {year}"
