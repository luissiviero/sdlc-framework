+++    fail case can drop exactly one thing."""
+++    if write_lesson_file:
+++        write_lesson(tmp_path / "lessons" / f"2026-10-{LESSON_SLUG}.md", **(lesson_overrides or {}))
+++    if extra_lesson_name:
