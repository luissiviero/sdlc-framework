+++++++
+++++++PLUGIN_DIR = Path(__file__).resolve().parent.parent
+++++++if str(PLUGIN_DIR) not in sys.path:
+++++++    sys.path.insert(0, str(PLUGIN_DIR))
+++++++
+++++++from state import yamlish  # noqa: E402
+++++++
+++++++LESSONS_DIR = "lessons"
+++++++INDEX_FILE = "index.md"
