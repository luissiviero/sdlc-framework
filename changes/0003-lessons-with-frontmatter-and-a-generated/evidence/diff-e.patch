++++    groups: dict[str, list[Entry]] = {}
++++    for e in stable:
++++        groups.setdefault(normalise_class(e.tags[0]), []).append(e)
++++    for cls in sorted(groups):
++++        blocks.append([f"## {cls}"] + [_render_line(e, today) for e in _sort_entries(groups[cls])])
++++    if retired:
