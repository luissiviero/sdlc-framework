++++        )
++++    fm_text, body = split
++++    try:
++++        fm = yamlish.loads(fm_text)
++++    except yamlish.YamlishError as exc:
++++        return Entry(path.name, ok=False, error=str(exc), heading=_first_heading(body))
++++    if not isinstance(fm, dict):
++++        return Entry(
