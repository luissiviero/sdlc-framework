++++++    problems = []
++++++    if not isinstance(fm.get("title"), str) or not fm["title"].strip():
++++++        problems.append("missing title")
++++++    if not isinstance(fm.get("description"), str) or not fm["description"].strip():
++++++        problems.append("missing description")
