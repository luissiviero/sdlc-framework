+            "leaves empty"
+            for i in _drive_items(plan)
+        ]
+    if problems:
+        return _fail("proof_items", "; ".join(problems), PROOF_ITEMS_NEED, problems=problems)
+    return _ok("proof_items", "the Proof items follow the grammar")
