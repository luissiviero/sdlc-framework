+GITHUB_RUN_VARS = ("GITHUB_RUN_ID", "GITHUB_SERVER_URL", "GITHUB_REPOSITORY", "GITHUB_EVENT_NAME")
+PROOF_KINDS = ("state", "screenshot")  # the kinds the drive produces; ``test`` is the suite's
