+    )
+
+
+STATE_ITEMS = [
+    {"item": "a", "kind": "state", "approved": True, "outcome": "matches"},
+    {"item": "b", "kind": "state", "approved": True, "outcome": "differs"},
+    {"item": "c", "kind": "screenshot", "approved": True, "outcome": "matches"},
