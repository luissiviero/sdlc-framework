+            need,
+            hits=hits,
+            declared=declared,
+            skip_markers=skip_markers,
+            accepted=sorted(accepted),
+        )
+    return _ok(
+        "ratchets",
+        "no undeclared test file or eval case drop",
+        declared=declared,
+        skip_markers=skip_markers,
+        accepted=sorted(accepted),
+    )
