++    a file under a case folder the diff never touches carries no ``--name-status`` record at
++    all (panel decision #2, phase b)."""
++    if not ref:
++        return []
++    out = _git(root, "ls-tree", "-r", "--name-only", "-z", ref, "--", prefix, check=False)
++    return _z(out)
